{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saya.si/schemas/infinity/event-v0.json",
  "title": "Infinity event v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "actor",
    "time",
    "type",
    "payload",
    "parents"
  ],
  "properties": {
    "schema": {
      "const": "infinity.event.v0"
    },
    "id": {
      "type": "string",
      "pattern": "^event:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^event:[0-9a-f]{64}$"
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "publicKey",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
