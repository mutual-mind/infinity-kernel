{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saya.si/schemas/infinity/causal-node-v0.json",
  "title": "Causal Spine node v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "actorRefs",
    "attributes"
  ],
  "properties": {
    "schema": {
      "const": "infinity.causal-node.v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "observation",
        "state",
        "interpretation",
        "intention",
        "action",
        "outcome",
        "evidence",
        "capability",
        "event"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "actorRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attributes": {
      "type": "object"
    }
  }
}
