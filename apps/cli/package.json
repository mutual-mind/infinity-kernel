{
  "name": "@infinity/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "infinity": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @infinity/kernel build && pnpm --filter @infinity/storage-files build && pnpm --filter @infinity/projection-sqlite build && tsx src/main.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint not configured yet'"
  },
  "dependencies": {
    "@infinity/kernel": "workspace:*",
    "@infinity/storage-files": "workspace:*",
    "@infinity/projection-sqlite": "workspace:*"
  }
}
